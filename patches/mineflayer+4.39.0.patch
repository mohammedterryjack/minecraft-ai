@@ -127,12 +127,19 @@ function inject (bot, { version, storageBuilder, hideErrors }) {
     // match in the palette, we can skip this section.
     if (section.palette) {
       for (const stateId of section.palette) {
-        if (matcher(Block.fromStateId(stateId, 0))) {
+        if (matcher.forState ? matcher.forState(stateId) : matcher(Block.fromStateId(stateId, 0))) {
           return true // the block is in the palette
         }
       }
       return false // skip
     }
+    // minecraft-ai fix96: a section of ONE state (all air above ground, all stone or water below) is stored as a
+    // single-value container: it has no palette, and was treated as "global palette" here, so all 4096 of its blocks
+    // were read with blockAt on every search. Its one state answers the question.
+    if (section.data && section.data.palette === undefined && Object.hasOwn(section.data, 'value')) {
+      const stateId = section.data.value
+      return matcher.forState ? matcher.forState(stateId) : matcher(Block.fromStateId(stateId, 0))
+    }
     return true // global palette, the block might be in there
   }
 
@@ -154,10 +161,37 @@ function inject (bot, { version, storageBuilder, hideErrors }) {
   }
 
   bot.findBlocks = (options) => {
-    const matcher = getMatchingFunction(options.matching)
+    // minecraft-ai fix97: maxDistance || 16 and count || 1 kept an array (truthy), and (array + 8) is a string.
+    // A length-2 array becomes NaN, Math.ceil(NaN) is NaN, and OctahedronIterator never finishes (apothem > NaN),
+    // so the main thread scans until the watchdog SIGKILLs it. A missing value is not a finite number either.
+    if (options === null || typeof options !== 'object' || Array.isArray(options)) {
+      throw new Error(`findBlocks: options object required, got ${options === null ? 'null' : Array.isArray(options) ? JSON.stringify(options) : typeof options}`)
+    }
+    for (const key of ['maxDistance', 'count']) {
+      if (!Object.hasOwn(options, key) || typeof options[key] !== 'number' || !Number.isFinite(options[key])) {
+        const v = options[key]
+        const shown = v === undefined ? 'undefined' : (typeof v === 'object' ? JSON.stringify(v) : String(v))
+        throw new Error(`findBlocks: ${key} must be a finite number, got ${shown}. matching is a block id, an array of block ids, or a function; maxDistance and count are numbers`)
+      }
+    }
+    const blockMatcher = getMatchingFunction(options.matching)
+    // minecraft-ai fix96: the palette check built a Block (Block.fromStateId) for every palette entry of every loaded
+    // section on every call, so a search for an absent block cost seconds (live: 15-17.6 s per call, then the watchdog
+    // killed the process). A section palette holds state ids; the same states repeat across sections, so each state is
+    // matched once per call and remembered. Same matcher, same answer (the palette check already used state + biome 0).
+    const stateMatch = new Map()
+    const matcher = (block) => blockMatcher(block)
+    matcher.forState = (stateId) => {
+      let m = stateMatch.get(stateId)
+      if (m === undefined) {
+        m = blockMatcher(Block.fromStateId(stateId, 0))
+        stateMatch.set(stateId, m)
+      }
+      return m
+    }
     const point = (options.point || bot.entity.position).floored()
-    const maxDistance = options.maxDistance || 16
-    const count = options.count || 1
+    const maxDistance = options.maxDistance
+    const count = options.count
     const useExtraInfo = options.useExtraInfo || false
     const fullMatcher = getFullMatchingFunction(matcher, useExtraInfo)
     const start = new Vec3(Math.floor(point.x / 16), Math.floor(point.y / 16), Math.floor(point.z / 16))
@@ -207,7 +241,9 @@ function inject (bot, { version, storageBuilder, hideErrors }) {
   }
 
   function findBlock (options) {
-    const blocks = bot.findBlocks(options)
+    // findBlock is one block by definition (mineflayer returns the nearest match, or null).
+    // findBlocks now requires a finite count, and callers pass { matching, maxDistance } only.
+    const blocks = bot.findBlocks(Object.assign({}, options, { count: 1 }))
     if (blocks.length === 0) return null
     return bot.blockAt(blocks[0])
   }
